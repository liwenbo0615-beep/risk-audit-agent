# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 忽略，切勿提交真实 key。
# ⚠️ 本文件会被提交到仓库，这里只能放占位符，绝不能填真实 API Key。

# DeepSeek（在线模式必填）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 运行模式：0=在线调用 DeepSeek（LLM 优先）  1=纯离线规则（不联网/不花钱）
OFFLINE_DEMO_MODE=1

# 审计日志落盘路径
AUDIT_LOG_PATH=audit_log.jsonl

# 异步人工复核待审队列的持久化文件
REVIEW_STORE_PATH=review_queue.json

# CLI 不读取该变量做人审自动决策；需要自动跳过时请显式传 -d skip。
# 保留为空，避免环境变量静默覆盖 Human-in-the-loop。
AUTO_REVIEW_DECISION=

# LLM 调用超时/重试
LLM_TIMEOUT=8
LLM_MAX_RETRIES=0

# LLM 调用调度
JUDGE_ENABLED=1
JUDGE_MIN_CONFIDENCE=0.90
